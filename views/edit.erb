<h2>メモを編集</h2>
<form action="/memos/<%= @id %>" method="post">

  <input type="hidden" name="_method" value="patch" autocomplete="off">

  <div class="form-group">
    <label for="title">タイトル</label>
    <input type="text" id="title" name="title" value="<%= h @memo["title"] %>" autocomplete="off">
  </div>

  <div class="form-group">
    <label for="content">内容</label>
    <textarea id="content" name="content"><%= h @memo["content"] %></textarea>
  </div>

  <div class="form-group">
    <input type="submit" value="更新" autocomplete="off">
  </div>

</form>
